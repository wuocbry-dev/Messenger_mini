# Production environment for docker-compose.prod.yml.
# Copy to .env.production on the server and fill in real values. Never commit it.

# Where the frontend container listens on the host.
#   80                 -> serve HTTP directly (or behind Cloudflare proxy)
#   127.0.0.1:8081     -> behind a host nginx + certbot that handles HTTPS
HTTP_BIND=80

# Public URL of the site (used for CORS).
CORS_ALLOWED_ORIGINS=https://chat.example.com

DB_NAME=messenger_mini
DB_USERNAME=messenger_user
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_DAYS=90

R2_ENDPOINT=https://example-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=messenger-mini
R2_PRESIGNED_TTL_SECONDS=900
R2_KEY_PREFIX=messenger/

AGORA_APP_ID=change-me
AGORA_APP_CERTIFICATE=change-me

# JVM flags for the backend container.
JAVA_OPTS=-XX:MaxRAMPercentage=75
