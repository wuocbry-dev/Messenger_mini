# Repository-level example only.
# Copy the backend/frontend examples into local .env files as needed.

SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=3306
DB_NAME=messenger_mini
DB_USERNAME=messenger_user
DB_PASSWORD=change-me

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_DAYS=90

R2_ENDPOINT=https://example-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=messenger-mini-dev

AGORA_APP_ID=change-me
AGORA_APP_CERTIFICATE=change-me

# Gmail SMTP: MAIL_USERNAME is the Gmail address, MAIL_PASSWORD its 16-char App Password.
MAIL_USERNAME=your.account@gmail.com
MAIL_PASSWORD=change-me
MAIL_FROM_NAME=Messenger Mini
APP_PUBLIC_URL=http://localhost:5173
