# Frontend environment variables.
# Only PUBLIC values — never put backend secrets (Agora App Certificate, R2 keys, JWT secret).

# API Backend URL
# Thay đổi thành IP của máy server khi dùng trên mạng LAN
VITE_API_URL=http://localhost:8080

# Agora App ID (public). Phải trùng với AGORA_APP_ID ở backend/.env,
# vì token do backend ký theo App ID của backend.
# Để trống thì dùng appId do backend trả về.
VITE_AGORA_APP_ID=
