# Frontend environment variables.
# Only PUBLIC values — never put backend secrets (Agora App Certificate, R2 keys, JWT secret).

# Leave VITE_API_URL / VITE_WS_URL UNSET for local dev and dev tunnels: the app
# then calls the same origin and the Vite proxy forwards /api and /ws to the backend.
# Set them only when the frontend is hosted separately from the backend.
# VITE_API_URL=https://api.example.com
# VITE_WS_URL=wss://api.example.com/ws
VITE_AGORA_APP_ID=

# Dev-server proxy (read by vite.config.ts only; not bundled into the browser).
# DEV_PROXY_TARGET=http://localhost:8080
# DEV_PROXY_ORIGIN=http://localhost:5173
